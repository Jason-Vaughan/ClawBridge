BRIDGE_PORT=3201

# ── Two different tokens. Only one of them is issued to you. ──

# BRIDGE_TOKEN — a secret YOU invent. Callers send it as `Authorization: Bearer <token>`.
# Deliberately left empty: the bridge refuses to start without it, and a placeholder here
# would satisfy that check and hand you a running bridge with a guessable credential on a
# 0.0.0.0 bind. Generate one:
#
#   openssl rand -base64 32
#
BRIDGE_TOKEN=

# CLAUDE_CODE_OAUTH_TOKEN — issued by Claude Code, not invented. Run `claude setup-token`
# and paste the result. Keychain auth will not work under launchd or SSH.
CLAUDE_CODE_OAUTH_TOKEN=

# Directory containing the projects the bridge may operate on.
PROJECTS_DIR=/path/to/your/projects
